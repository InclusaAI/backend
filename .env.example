# InclusaAI backend — general (shared) local development env.
#
# Values that every service must see identically. Each app's own
# apps/<service>/.env holds the service-specific entries (DATABASE_URL, PORT,
# REDIS_URL, ...) and takes precedence over this file, so an app only repeats a
# variable here when it must deviate.
#
# Copy to .env and fill in. Never commit .env.
# Loaded automatically by each service's ConfigModule and by the e2e setups;
# deployed services get the same values from the render.yaml `backend-shared`
# env var group instead.

# --- Token secrets ------------------------------------------------------------
# JWT_SECRET signs the account tokens: issued by identity-service, verified by
# identity- and session-service. PARTICIPANT_TOKEN_SECRET signs participant
# tokens: issued by session-service, verified by session-, preference- and
# fanout-service. The two must differ — that separation is what stops a
# participant token acting as an account token.
# Generate each with: openssl rand -base64 48
JWT_SECRET=
PARTICIPANT_TOKEN_SECRET=

# --- Kafka --------------------------------------------------------------------
# Locally this is the Redpanda broker in docker-compose.dev.yml, which speaks
# PLAINTEXT and needs nothing else. Hosted brokers (Aiven Cloud Kafka,
# Confluent, ...) terminate TLS and require SASL; set these instead:
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=plain                     # or scram-sha-256/-512
#   KAFKA_USERNAME=  KAFKA_PASSWORD=
#   KAFKA_CA_CERT=certs/aiven-kafka-ca.pem  # PEM path or contents; in Docker
#                                            # it is /usr/src/app/certs/...
#   KAFKA_CONNECTION_TIMEOUT_MS=10000      # 3000 (kafkajs default) is tight
#                                          # for a TLS handshake to a distant broker
# KAFKA_BROKER is still read as the legacy name for KAFKA_BOOTSTRAP_SERVERS.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Browser access -------------------------------------------------------------
# Comma-separated frontend origins, identical for every service. Without the
# real domains browsers are blocked even though curl works.
CORS_ORIGINS=http://localhost:3000
