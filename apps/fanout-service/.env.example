# fanout-service
# Copy to .env and fill in. Never commit .env.
#
# Shared values (Kafka connection, PARTICIPANT_TOKEN_SECRET, CORS_ORIGINS)
# live in the general env at the repo root: backend/.env.example. This app's
# .env wins over the general env, so only list values specific to this
# service here.
#
# No database: Redis-only, ephemeral state (see IMPLEMENTATION.md section 2).
# On Render this is the Key Value instance's internal URL, injected as REDIS_URL.
REDIS_URL=redis://localhost:6390

# Verifies the participant tokens session-service issues on join; the secret
# itself comes from the general env. This service never verifies account
# tokens, so it reads no JWT_SECRET.

PORT=3004

# Entries kept in the shared socket.io Redis stream. This bounds how far back a
# reconnecting client can be caught up, so it must hold well over two minutes
# (the recovery window) of captions across all live sessions.
FANOUT_STREAM_MAXLEN=100000
