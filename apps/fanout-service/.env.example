# fanout-service
# Copy to .env and fill in. Never commit .env.
#
# No database: Redis-only, ephemeral state (see IMPLEMENTATION.md section 2).

REDIS_URL=redis://localhost:6390

# Verifies the participant tokens session-service issues on join. Must match
# session-service's PARTICIPANT_TOKEN_SECRET. This service never verifies
# account tokens, so it has no JWT_SECRET.
PARTICIPANT_TOKEN_SECRET=

KAFKA_BROKER=localhost:29092

PORT=3004

# Entries kept in the shared socket.io Redis stream. This bounds how far back a
# reconnecting client can be caught up, so it must hold well over two minutes
# (the recovery window) of captions across all live sessions.
FANOUT_STREAM_MAXLEN=100000

# Comma-separated browser origins allowed to connect (REST + WebSocket).
CORS_ORIGINS=http://localhost:3000
