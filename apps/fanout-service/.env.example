# fanout-service
# Copy to .env and fill in. Never commit .env.
#
# No database: Redis-only, ephemeral state (see IMPLEMENTATION.md section 2).

REDIS_URL=redis://localhost:6379

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

KAFKA_BROKER=localhost:29092

PORT=3004

# Comma-separated browser origins allowed to connect (REST + WebSocket).
CORS_ORIGINS=http://localhost:3000
