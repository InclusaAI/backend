// identity-service — owns users, organizations, org memberships and invitations.
//
// Per ADR-0003 this service has its own logical database. It must not define
// models owned by another service; cross-service references are plain string
// IDs with no foreign key, and cross-service reads go over REST/gRPC/Kafka.
//
// Accessibility preferences are owned by preference-service.

// Generated into this service so it is never overwritten by a sibling
// service's `prisma generate`. pnpm dedupes an identical @prisma/client
// version across packages into one physical directory, so the default
// output location is shared and each generate clobbers the last.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrgMembership[]
  invitations Invitation[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrgMembership[]
  invitations Invitation[]

  @@map("organizations")
}

model OrgMembership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER") // ADMIN, MEMBER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("org_memberships")
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  token          String       @unique
  expiresAt      DateTime
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  organizationId String
  inviterId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  inviter        User         @relation(fields: [inviterId], references: [id])

  @@map("invitations")
}
