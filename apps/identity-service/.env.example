# identity-service
# Copy to .env and fill in. Never commit .env.

# Owns: users, organizations, org_memberships, invitations
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-identity?schema=public"

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Kafka. Locally this is the Redpanda broker in docker-compose.dev.yml, which
# speaks PLAINTEXT and needs nothing else. Hosted brokers (Aiven Cloud Kafka,
# Confluent, ...) terminate TLS and require SASL; set these instead:
#   KAFKA_SECURITY_PROTOCOL=SASL_SSL
#   KAFKA_SASL_MECHANISM=plain                     # or scram-sha-256/-512
#   KAFKA_USERNAME=  KAFKA_PASSWORD=
#   KAFKA_CA_CERT=/usr/src/app/certs/aiven-kafka-ca.pem   # PEM path or contents
#   KAFKA_CONNECTION_TIMEOUT_MS=10000          # 3000 (kafkajs default) is tight
#                        for a TLS handshake to a distant broker
# KAFKA_BROKER is still read as the legacy name for KAFKA_BOOTSTRAP_SERVERS.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

PORT=3001

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000
