# identity-service
# Copy to .env and fill in. Never commit .env.
#
# Shared values (Kafka connection, JWT_SECRET, CORS_ORIGINS) live in the
# general env at the repo root: backend/.env.example. This app's .env wins
# over the general env, so only list values specific to this service here.

# Owns: users, organizations, org_memberships, invitations
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-identity?schema=public"

PORT=3001
