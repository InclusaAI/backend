# identity-service
# Copy to .env and fill in. Never commit .env.

# Owns: users, organizations, org_memberships, invitations
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-identity?schema=public"

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

KAFKA_BROKER=localhost:29092

PORT=3001

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000
