// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Generated into this service so it is never overwritten by a sibling
// service's `prisma generate` — see the note in identity-service's schema.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessibilityPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  captionsEnabled Boolean  @default(false)
  avatarEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("accessibility_preferences")
}