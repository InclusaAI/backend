# preference-service
# Copy to .env and fill in. Never commit .env.

# Owns: accessibility_preferences
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-preferences?schema=public"

# Verifies the participant tokens session-service issues on join, so it must
# match session-service and fanout-service, and differ from JWT_SECRET.
# This service never verifies account tokens, so it has no JWT_SECRET.
# Generate with: openssl rand -base64 48
PARTICIPANT_TOKEN_SECRET=

# Kafka — apps/identity-service/.env.example lists the extra variables a hosted
# broker (Aiven: SASL_SSL + credentials + CA certificate) needs.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

PORT=3003

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000
