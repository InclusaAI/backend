# presenter-assist-service
# Copy to .env and fill in. Never commit .env.
#
# Deferred to post-MVP (see IMPLEMENTATION.md section 7).

DATABASE_URL="postgresql://user:password@localhost:5432/presenter_assist_db?schema=public"

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

KAFKA_BROKER=localhost:29092

PORT=3005

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000
