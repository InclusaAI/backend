# presenter-assist-service
# Copy to .env and fill in. Never commit .env.
#
# Deferred to post-MVP (see IMPLEMENTATION.md section 7).
#
# Shared values (Kafka connection, JWT_SECRET, CORS_ORIGINS) live in the
# general env at the repo root: backend/.env.example. This app's .env wins
# over the general env, so only list values specific to this service here.

DATABASE_URL="postgresql://user:password@localhost:5432/presenter_assist_db?schema=public"

PORT=3005
