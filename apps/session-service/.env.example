# session-service
# Copy to .env and fill in. Never commit .env.
#
# Shared values (Kafka connection, JWT_SECRET, PARTICIPANT_TOKEN_SECRET,
# CORS_ORIGINS) live in the general env at the repo root:
# backend/.env.example. This app's .env wins over the general env, so only
# list values specific to this service here.

# Owns: presentations, sessions, join_tokens, session_participants
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-sessions?schema=public"

PORT=3002

# Used when seeding a joining participant's accessibility preferences.
# On a platform that assigns private-network hostnames at deploy time, leave
# this unset and provide PREFERENCE_SERVICE_HOST instead (e.g.
# preference-service-abc1:10000 on Render).
PREFERENCE_SERVICE_URL=http://localhost:3003
