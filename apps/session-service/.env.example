# session-service
# Copy to .env and fill in. Never commit .env.

# Owns: presentations, sessions, join_tokens, session_participants
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-sessions?schema=public"

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

KAFKA_BROKER=localhost:29092

PORT=3002

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000

# Used when seeding a joining participant's accessibility preferences.
PREFERENCE_SERVICE_URL=http://localhost:3003
