# session-service
# Copy to .env and fill in. Never commit .env.

# Owns: presentations, sessions, join_tokens, session_participants
DATABASE_URL="postgresql://user:password@localhost:5440/synapgrid-sessions?schema=public"

# Must be identical across all services that verify tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Signs participant tokens issued on join. Must match fanout-service, and must
# be DIFFERENT from JWT_SECRET. Generate with: openssl rand -base64 48
PARTICIPANT_TOKEN_SECRET=

# Kafka — apps/identity-service/.env.example lists the extra variables a hosted
# broker (Aiven: SASL_SSL + credentials + CA certificate) needs.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

PORT=3002

# Comma-separated browser origins allowed to call this service.
CORS_ORIGINS=http://localhost:3000

# Used when seeding a joining participant's accessibility preferences.
# On a platform that assigns private-network hostnames at deploy time, leave
# this unset and provide PREFERENCE_SERVICE_HOST instead (e.g.
# preference-service-abc1:10000 on Render).
PREFERENCE_SERVICE_URL=http://localhost:3003
